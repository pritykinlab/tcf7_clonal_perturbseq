            --dataset NT={input.nt_data} \
            --dataset Trim28={input.trim28_data} \
            --output-prefix {OUTPUT_DIR}/trim28_setdb1/lowest_loss_points_multi_view \
            --n-points 100 \
            --skip-highlight
        """

