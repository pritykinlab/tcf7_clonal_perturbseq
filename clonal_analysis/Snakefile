rule all_perturbation_fits:
    """Generate all clonal-model fits and diagnostics across perturbations."""
    input:
        rules.gene10_all_perturbation_diagnostics.input,
        rules.trim28_setdb1_all_perturbation_diagnostics.input

rule all_plots:
    """Generate all visualization plots across datasets"""
    input:
        rules.gene10_plots.input,
        rules.trim28_setdb1_plots.input
