        """

rule bar_plot_parameters_gene10:
    """Generate bar plot comparing permissible parameter ranges for gene10 perturbations"""
    input:
        expand(f"{OUTPUT_DIR}/gene10/{{perturbation}}/grid_search_loss.npz", perturbation=GENE10_PERTURBATIONS)
    output:
        f"{OUTPUT_DIR}/gene10/parameter_ranges_bar_plot.png"
    params:
        dataset_args=" ".join(
            [
                f"--dataset {perturbation}={OUTPUT_DIR}/gene10/{perturbation}/grid_search_loss.npz"
                for perturbation in GENE10_PERTURBATIONS
            ]
        )
    shell:
        """
        {PYTHON_ENV} {SCRIPTS_DIR}/bar_plot_parameters.py \
            {params.dataset_args} \
            --output {output} \
            --n-points 50
        """

rule bar_plot_parameters_trim28_setdb1:
    """Generate bar plot comparing permissible parameter ranges for trim28_setdb1 perturbations"""
    input:
        expand(f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/grid_search_loss.npz", perturbation=TRIM28_PERTURBATIONS)
    output:
        f"{OUTPUT_DIR}/trim28_setdb1/parameter_ranges_bar_plot.png"
    params:
        dataset_args=" ".join(
            [
                f"--dataset {perturbation}={OUTPUT_DIR}/trim28_setdb1/{perturbation}/grid_search_loss.npz"
                for perturbation in TRIM28_PERTURBATIONS
            ]
        )
    shell:
        """
        {PYTHON_ENV} {SCRIPTS_DIR}/bar_plot_parameters.py \
            {params.dataset_args} \
            --output {output} \
            --n-points 50
        """

# Master rule to generate all plots
rule gene10_plots:
    """Generate all gene10 visualization plots"""
    input:
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_3d.html",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_multi_view.png",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_multi_view_projections.png",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_multi_view_equations.txt",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_multi_view_projections_legend.png",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_multi_view_projections_legend.svg",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_best_nt_ecdf.png",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_best_nt_ecdf.svg",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_best_nt_isotonic.png",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_best_nt_isotonic.svg",
        f"{OUTPUT_DIR}/gene10/lowest_loss_points_best_nt_parameters.txt",
        f"{OUTPUT_DIR}/gene10/parameter_ranges_bar_plot.png"

rule trim28_setdb1_plots:
    """Generate all trim28 experiment visualization plots"""
    input:
        f"{OUTPUT_DIR}/trim28_setdb1/lowest_loss_points_3d.html",
        f"{OUTPUT_DIR}/trim28_setdb1/lowest_loss_points_multi_view.png",
        f"{OUTPUT_DIR}/trim28_setdb1/lowest_loss_points_multi_view_projections.png",
        f"{OUTPUT_DIR}/trim28_setdb1/lowest_loss_points_multi_view_equations.txt",
        f"{OUTPUT_DIR}/trim28_setdb1/parameter_ranges_bar_plot.png",
        expand(
            f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_ecdf.png",
            perturbation=TRIM28_PLOT_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_ecdf.svg",
            perturbation=TRIM28_PLOT_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_isotonic.png",
            perturbation=TRIM28_PLOT_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_isotonic.svg",
            perturbation=TRIM28_PLOT_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/trim28_setdb1/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_parameters.txt",
            perturbation=TRIM28_PLOT_PERTURBATIONS,
        )

rule gene10_all_perturbation_diagnostics:
    """Generate grid searches and diagnostics for all gene10 perturbations."""
    input:
        expand(
            f"{OUTPUT_DIR}/gene10/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_ecdf.png",
            perturbation=GENE10_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/gene10/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_ecdf.svg",
            perturbation=GENE10_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/gene10/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_isotonic.png",
            perturbation=GENE10_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/gene10/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_isotonic.svg",
            perturbation=GENE10_PERTURBATIONS,
        ),
        expand(
            f"{OUTPUT_DIR}/gene10/{{perturbation}}/lowest_loss_points_best_{{perturbation}}_parameters.txt",
            perturbation=GENE10_PERTURBATIONS,
        ),
        f"{OUTPUT_DIR}/gene10/parameter_ranges_bar_plot.png"

