rule SRA_metadata_submission:
    """Populate the consolidated SRA metadata template from staged FASTQs and metadata tables."""
    input:
        script=SRA_METADATA_SCRIPT,
        template=SRA_METADATA_TEMPLATE,
        rnaseq="../data_submissions/SRA/metadata/figure1c_rnaseq_sra_metadata.tsv",
        single_cell="../data_submissions/SRA/metadata/tcf7_sc_sra_metadata_draft.tsv",
        pooled_fastq_dir="../data_submissions/SRA/Figure1_fastq"
    output:
        workbook=SRA_METADATA_WORKBOOK,
        submission_tsv=SRA_METADATA_SUBMISSION_TSV,
        poolq_tsv=SRA_POOLQ_METADATA_TSV
    shell:
        """
        {PYTHON_ENV} {input.script}
        """

rule BioSample_metadata_submission:
    """Populate the NCBI BioSample model-organism animal template from staged metadata."""
    input:
        script=BIOSAMPLE_METADATA_SCRIPT,
        rnaseq="../data_submissions/SRA/metadata/figure1c_rnaseq_biosample_attributes.tsv",
        single_cell="../data_submissions/SRA/metadata/tcf7_sc_biosample_attributes_draft.tsv",
        pooled_fastq_dir="../data_submissions/SRA/Figure1_fastq",
        manual_overrides=BIOSAMPLE_MANUAL_OVERRIDES_TSV
    output:
        workbook=BIOSAMPLE_METADATA_WORKBOOK,
        submission_tsv=BIOSAMPLE_METADATA_SUBMISSION_TSV,
        poolq_tsv=BIOSAMPLE_POOLQ_ATTRIBUTES_TSV,
        todo_tsv=BIOSAMPLE_METADATA_TODO_TSV
    shell:
        """
        {PYTHON_ENV} {input.script}
        """

