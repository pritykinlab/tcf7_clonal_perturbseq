        """

# =============================================================================
# BULK RNA-SEQ NORMALIZATION FOR FIGURE 1c AND FIGURE S1a-b
# =============================================================================

rule Figure1_rnaseq_prepare_tx2gene:
    """Prepare sample and transcript-to-gene tables for the bulk RNA-seq DESeq2 normalization"""
    input:
        script=f"{SCRIPTS_DIR}/bulk_rnaseq_prepare_tx2gene.py",
        metadata=TCELL_COMBO_METADATA,
        gtf=MOUSE_GENCODE_GTF,
        quant_files=RNASEQ_SALMON_LCMV_QUANTS
    output:
        sample_table=f"{RNASEQ_DESEQ2_DIR}/sample_table.tsv",
        tx2gene=f"{RNASEQ_DESEQ2_DIR}/tx2gene.tsv",
        gene_metadata=f"{RNASEQ_DESEQ2_DIR}/gene_metadata.tsv"
    params:
        quant_dir=TCELL_COMBO_SALMON_LCMV_DIR
    shell:
        """
        {PYTHON_ENV} {input.script} \
            --gtf {input.gtf} \
            --quant-dir {params.quant_dir} \
            --metadata {input.metadata} \
            --tx2gene-output {output.tx2gene} \
            --gene-metadata-output {output.gene_metadata} \
            --sample-table-output {output.sample_table}
        """

rule Figure1_rnaseq_deseq2_normalized_counts:
    """Generate gene-level DESeq2-normalized bulk RNA-seq expression from Salmon transcript counts"""
    input:
        script=f"{SCRIPTS_DIR}/bulk_rnaseq_deseq2_normalize.R",
        sample_table=rules.Figure1_rnaseq_prepare_tx2gene.output.sample_table,
        tx2gene=rules.Figure1_rnaseq_prepare_tx2gene.output.tx2gene,
        gene_metadata=rules.Figure1_rnaseq_prepare_tx2gene.output.gene_metadata,
        quant_files=RNASEQ_SALMON_LCMV_QUANTS
    output:
        normalized_counts=RNASEQ_DESEQ2_NORMALIZED_COUNTS,
        vst_expression=RNASEQ_DESEQ2_VST_EXPRESSION,
        size_factors=f"{RNASEQ_DESEQ2_DIR}/deseq2_size_factors.tsv",
        session_info=f"{RNASEQ_DESEQ2_DIR}/deseq2_session_info.txt"
    shell:
        """
        if ! command -v {RSCRIPT} >/dev/null 2>&1; then
            echo "ERROR: Rscript was not found. Set RSCRIPT to an Rscript executable with DESeq2 installed." >&2
            exit 127
        fi
        {RSCRIPT} {input.script} \
            --sample-table {input.sample_table} \
            --tx2gene {input.tx2gene} \
            --gene-metadata {input.gene_metadata} \
            --normalized-counts-output {output.normalized_counts} \
            --vst-expression-output {output.vst_expression} \
            --size-factors-output {output.size_factors} \
            --session-info-output {output.session_info}
        """

rule Sup_Figure_1_1a_rnaseq_pca_coordinates:
