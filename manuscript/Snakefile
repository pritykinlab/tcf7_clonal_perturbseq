        tables=SUPPLEMENTARY_TABLE_TSVS
    output:
        workbook=SUPPLEMENTARY_TABLE_EXCEL
    shell:
        """
        {PYTHON_ENV} {input.script} \
            --captions {input.captions} \
            --output {output.workbook} \
            {input.tables}
        """

